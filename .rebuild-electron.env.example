# Override the defaults used by `rebuild-electron.ps1`.
# Copy this file to `.rebuild-electron.env` and edit the paths to match your machine.
#
# PYTHON_PATH defaults to the project venv (`.venv\Scripts\python.exe`), created by
# `npm run setup:python`. You only need to set it here to use a different interpreter.
# Whatever you point at must have setuptools installed: node-gyp's bundled gyp imports
# `distutils`, which Python 3.12 removed from the stdlib and setuptools re-provides.

#PYTHON_PATH=C:\Users\you\scoop\apps\python\3.12.1\python.exe
VCVARS_PATH=C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvarsall.bat
ARCH=x64
